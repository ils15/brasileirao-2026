#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel) || {
  printf '%s\n' 'pre-commit: não foi possível localizar a raiz do repositório.' >&2
  exit 1
}
cd "$repo_root"

if ! command -v npm >/dev/null 2>&1; then
  printf '%s\n' 'pre-commit: npm não encontrado; instale Node.js/npm e as dependências manualmente. Nenhuma instalação automática foi executada.' >&2
  exit 1
fi

# Gate condicional por caminho (scripts/lib/commitGate.mjs): dados gerados rodam
# só `npm run test:data`; qualquer outro caminho roda suíte completa + build de
# Pages. A checagem de whitespace (`git diff --cached --check`) fica no runner,
# que falha fechado (`full`) quando não consegue listar os caminhos staged.
exec node scripts/pre-commit-gate.mjs
